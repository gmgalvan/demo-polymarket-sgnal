# Shared configuration for the infra-images scripts/Makefile.
# Override any of these as environment variables before calling `make`,
# e.g.:  AWS_REGION=us-west-2 make create

AWS_REGION="${AWS_REGION:-us-east-1}"
IMAGE_TAG="${IMAGE_TAG:-latest}"

# Platforms to build for. This is the whole point of the EKS demo:
# these images are meant to run on Graviton (arm64) nodes, and this
# also lets the same image run on an amd64 dev laptop.
PLATFORMS="${PLATFORMS:-linux/amd64,linux/arm64}"

# ECR repository names (created/destroyed by these scripts)
BACKEND_REPO="api-spacy-finance"
FRONTEND_REPO="finance-chat-frontend"

# Path to each app's Dockerfile, relative to this file's directory
BACKEND_DIR="../api-spacy-finance"
FRONTEND_DIR="../finance-chat-frontend"

# URL the frontend bundle will call at runtime (baked in at build time,
# see finance-chat-frontend/Dockerfile). Point this at the backend's
# real EKS endpoint once it exists.
VITE_API_URL="${VITE_API_URL:-http://localhost:8000}"

# AWS tags applied to both ECR repositories (not Docker image tags).
# Component is set per-repo in the scripts (it's just the repo name).
PROJECT_TAG="${PROJECT_TAG:-polymarket-signal-demo}"
ENVIRONMENT_TAG="${ENVIRONMENT_TAG:-demo}"
MANAGED_BY_TAG="infra-images"

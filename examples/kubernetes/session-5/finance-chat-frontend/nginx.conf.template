# Rendered to /etc/nginx/conf.d/default.conf at container startup by the
# base nginx:alpine image's built-in envsubst-on-templates entrypoint
# script (anything under /etc/nginx/templates/*.template). ${API_UPSTREAM}
# below is substituted from the container's environment - no image rebuild
# needed to point at a different backend.
#
# Only ${API_UPSTREAM} is meant to be substituted. nginx's own $variables
# (lowercase: $uri, $host, $remote_addr, ...) are left alone because
# envsubst only replaces names that exist as actual environment variables,
# and none of those are set - just don't name a container env var the same
# as an nginx variable.
server {
    listen 80;

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    # The backend is never exposed on its own Ingress - this is the only
    # path a browser has to reach it, and only for these specific routes.
    location ~ ^/(health|ask|queries)$ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
